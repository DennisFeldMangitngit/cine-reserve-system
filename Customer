import java.util.*;

public class Customer extends User {
    private List<Booking> bookingHistory;

    public Customer(String name) {
        super(name);
        this.bookingHistory = new ArrayList<>();
    }

    public void browseMovies(Cinema cinema) {
        List<Movie> movies = cinema.getMovies();
        if (movies.isEmpty()) {
            System.out.println("No movies currently available.");
            return;
        }
        System.out.println("\n--- Movies available at " + cinema.getName() + " ---");
        for (int i = 0; i < movies.size(); i++) {
            System.out.println((i + 1) + ". " + movies.get(i).getTitle());
        }
    }

    public void selectSeats(Showtime showtime, List<Seat> selectedSeats) {
        for (Seat seat : selectedSeats) {
            showtime.reserveSeat(seat);
        }
    }

    public void addBooking(Booking booking) {
        bookingHistory.add(booking);
    }

    public void getBookingHistory() {
        if (bookingHistory.isEmpty()) {
            System.out.println("No booking history found.");
            return;
        }
        System.out.println("\n--- Booking History for " + name + " ---");
        for (Booking b : bookingHistory) {
            System.out.println("Booking #" + b.getBookingId()
                    + " | Tickets: " + b.getTickets().size()
                    + " | Status: " + (b.isConfirmed() ? "Confirmed" : "Pending"));
        }
    }

    public List<Booking> getBookings() { return bookingHistory; }
}
