public abstract class Ticket {
    protected double basePrice;

    public Ticket(double basePrice) {
        this.basePrice = basePrice;
    }

    public abstract double getPrice();
    public abstract String getType();

    @Override
    public String toString() {
        return getType() + " Ticket - PHP " + String.format("%.2f", getPrice());
    }
}

class AdultTicket extends Ticket {
    public AdultTicket(double basePrice) {
        super(basePrice);
    }

    @Override
    public double getPrice() {
        return basePrice;     }

    @Override
    public String getType() { return "Adult"; }
}

class StudentTicket extends Ticket {
    public StudentTicket(double basePrice) {
        super(basePrice);
    }

    @Override
    public double getPrice() {
        return basePrice * 0.80;
    }

    @Override
    public String getType() { return "Student (20% off)"; }
}

class SeniorTicket extends Ticket {
    public SeniorTicket(double basePrice) {
        super(basePrice);
    }

    @Override
    public double getPrice() {
        return basePrice * 0.75; 
    }

    @Override
    public String getType() { return "Senior (25% off)"; }
}
