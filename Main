import java.util.*;

public class Main {

    static Scanner scanner = new Scanner(System.in);
    static Cinema cinema;
    static Admin admin;
    static Customer currentCustomer;
    static int bookingCounter = 1;

    public static void main(String[] args) {
        cinema = new Cinema("CineReserve Pro", "Downtown");
        admin = new Admin("Admin");

        seedDefaultData();

        System.out.println("=============================================");
        System.out.println("       Welcome to CineReserve Pro           ");
        System.out.println("       Location: " + cinema.getAddress());
        System.out.println("=============================================");

        mainMenu();
    }

    static void seedDefaultData() {
        TheaterRoom room1 = new TheaterRoom("Room 1", "Standard", 30);
        TheaterRoom room2 = new TheaterRoom("Room 2", "Gold Class", 20);
        admin.manageRooms(cinema, room1);
        admin.manageRooms(cinema, room2);

        Movie movie1 = new Movie("Inception");
        List<Seat> seats1 = generateSeats('A', 5);
        Showtime st1 = new Showtime(new Date(), 250.0, seats1);
        admin.addMovie(cinema, movie1);
        admin.setShowtime(movie1, st1);

        Movie movie2 = new Movie("Interstellar");
        List<Seat> seats2 = generateSeats('B', 5);
        Showtime st2 = new Showtime(new Date(), 300.0, seats2);
        admin.addMovie(cinema, movie2);
        admin.setShowtime(movie2, st2);
    }

    static List<Seat> generateSeats(char row, int count) {
        List<Seat> seats = new ArrayList<>();
        for (int i = 1; i <= count; i++) {
            seats.add(new Seat(row, i));
        }
        return seats;
    }

    static void mainMenu() {
        while (true) {
            System.out.println("\n============== MAIN MENU ==============");
            System.out.println("1. Admin Panel");
            System.out.println("2. Customer Portal");
            System.out.println("3. Exit");
            System.out.print("Choose an option: ");

            String choice = scanner.nextLine().trim();

            switch (choice) {
                case "1": adminPanel(); break;
                case "2": customerPortal(); break;
                case "3":
                    System.out.println("Thank you for using CineReserve Pro. Goodbye!");
                    System.exit(0);
                    break;
                default:
                    System.out.println("Invalid option. Please try again.");
            }
        }
    }

    // ==================== ADMIN PANEL ====================

    static void adminPanel() {
        System.out.print("\nEnter Admin Name: ");
        String adminName = scanner.nextLine().trim();
        admin = new Admin(adminName);

        while (true) {
            System.out.println("\n======== ADMIN PANEL (" + adminName + ") ========");
            System.out.println("1. Add Movie");
            System.out.println("2. Remove Movie");
            System.out.println("3. Add Showtime to Movie");
            System.out.println("4. Add Theater Room");
            System.out.println("5. View All Movies");
            System.out.println("6. View Theater Rooms");
            System.out.println("7. Back to Main Menu");
            System.out.print("Choose an option: ");

            String choice = scanner.nextLine().trim();

            switch (choice) {
                case "1": adminAddMovie(); break;
                case "2": adminRemoveMovie(); break;
                case "3": adminAddShowtime(); break;
                case "4": adminAddTheaterRoom(); break;
                case "5": viewAllMovies(); break;
                case "6": viewTheaterRooms(); break;
                case "7": return;
                default: System.out.println("Invalid option.");
            }
        }
    }

    static void adminAddMovie() {
        System.out.print("Enter Movie Title: ");
        String title = scanner.nextLine().trim();
        if (title.isEmpty()) { System.out.println("Title cannot be empty."); return; }
        Movie movie = new Movie(title);
        admin.addMovie(cinema, movie);
        System.out.println("Movie \"" + title + "\" added successfully.");
    }

    static void adminRemoveMovie() {
        List<Movie> movies = cinema.getMovies();
        if (movies.isEmpty()) { System.out.println("No movies to remove."); return; }
        viewAllMovies();
        System.out.print("Enter movie number to remove: ");
        try {
            int idx = Integer.parseInt(scanner.nextLine().trim()) - 1;
            if (idx < 0 || idx >= movies.size()) { System.out.println("Invalid selection."); return; }
            Movie toRemove = movies.get(idx);
            admin.removeMovie(cinema, toRemove);
            System.out.println("Movie \"" + toRemove.getTitle() + "\" removed successfully.");
        } catch (NumberFormatException e) {
            System.out.println("Invalid input.");
        }
    }

    static void adminAddShowtime() {
        List<Movie> movies = cinema.getMovies();
        if (movies.isEmpty()) { System.out.println("No movies available. Add a movie first."); return; }
        viewAllMovies();
        System.out.print("Select movie number: ");
        try {
            int idx = Integer.parseInt(scanner.nextLine().trim()) - 1;
            if (idx < 0 || idx >= movies.size()) { System.out.println("Invalid selection."); return; }
            Movie movie = movies.get(idx);

            System.out.print("Enter ticket price (PHP): ");
            double price = Double.parseDouble(scanner.nextLine().trim());

            System.out.print("Enter number of seats: ");
            int seatCount = Integer.parseInt(scanner.nextLine().trim());

            char row = (char) ('A' + movie.getShowtimes().size());
            List<Seat> seats = generateSeats(row, seatCount);
            Showtime showtime = new Showtime(new Date(), price, seats);
            admin.setShowtime(movie, showtime);
            System.out.println("Showtime added for \"" + movie.getTitle() + "\" with " + seatCount + " seats (Row " + row + ").");
        } catch (NumberFormatException e) {
            System.out.println("Invalid number format.");
        }
    }

    static void adminAddTheaterRoom() {
        System.out.print("Enter Room Name: ");
        String roomName = scanner.nextLine().trim();

        System.out.println("Select Room Type:");
        System.out.println("1. Standard");
        System.out.println("2. Gold Class");
        System.out.print("Choice: ");
        String typeChoice = scanner.nextLine().trim();
        String roomType = typeChoice.equals("2") ? "Gold Class" : "Standard";

        System.out.print("Enter Capacity: ");
        try {
            int capacity = Integer.parseInt(scanner.nextLine().trim());
            TheaterRoom room = new TheaterRoom(roomName, roomType, capacity);
            admin.manageRooms(cinema, room);
            System.out.println("Theater room \"" + roomName + "\" (" + roomType + ") added successfully.");
        } catch (NumberFormatException e) {
            System.out.println("Invalid capacity.");
        }
    }

    static void viewAllMovies() {
        List<Movie> movies = cinema.getMovies();
        if (movies.isEmpty()) { System.out.println("No movies available."); return; }
        System.out.println("\n--- Movies ---");
        for (int i = 0; i < movies.size(); i++) {
            Movie m = movies.get(i);
            System.out.println((i + 1) + ". " + m.getTitle()
                    + " (" + m.getShowtimes().size() + " showtime(s))");
        }
    }

    static void viewTheaterRooms() {
        List<TheaterRoom> rooms = cinema.getTheaterRooms();
        if (rooms.isEmpty()) { System.out.println("No theater rooms available."); return; }
        System.out.println("\n--- Theater Rooms ---");
        for (int i = 0; i < rooms.size(); i++) {
            System.out.println((i + 1) + ". " + rooms.get(i));
        }
    }

    // ==================== CUSTOMER PORTAL ====================

    static void customerPortal() {
        System.out.print("\nEnter Your Name: ");
        String customerName = scanner.nextLine().trim();
        if (customerName.isEmpty()) customerName = "Guest";
        currentCustomer = new Customer(customerName);
        System.out.println("Welcome, " + customerName + "!");

        while (true) {
            System.out.println("\n======== CUSTOMER PORTAL (" + customerName + ") ========");
            System.out.println("1. Browse Movies");
            System.out.println("2. Book Tickets");
            System.out.println("3. View Booking History");
            System.out.println("4. Back to Main Menu");
            System.out.print("Choose an option: ");

            String choice = scanner.nextLine().trim();

            switch (choice) {
                case "1": currentCustomer.browseMovies(cinema); break;
                case "2": bookTickets(); break;
                case "3": currentCustomer.getBookingHistory(); break;
                case "4": return;
                default: System.out.println("Invalid option.");
            }
        }
    }

    static void bookTickets() {
        List<Movie> movies = cinema.getMovies();
        if (movies.isEmpty()) { System.out.println("No movies available for booking."); return; }

        currentCustomer.browseMovies(cinema);
        System.out.print("Select a movie number: ");
        int movieIdx;
        try {
            movieIdx = Integer.parseInt(scanner.nextLine().trim()) - 1;
            if (movieIdx < 0 || movieIdx >= movies.size()) { System.out.println("Invalid selection."); return; }
        } catch (NumberFormatException e) {
            System.out.println("Invalid input.");
            return;
        }
        Movie selectedMovie = movies.get(movieIdx);

        List<Showtime> showtimes = selectedMovie.getShowtimes();
        if (showtimes.isEmpty()) {
            System.out.println("No showtimes available for " + selectedMovie.getTitle());
            return;
        }
        System.out.println("\n--- Showtimes for " + selectedMovie.getTitle() + " ---");
        for (int i = 0; i < showtimes.size(); i++) {
            System.out.println((i + 1) + ". " + showtimes.get(i));
        }
        System.out.print("Select showtime number: ");
        int stIdx;
        try {
            stIdx = Integer.parseInt(scanner.nextLine().trim()) - 1;
            if (stIdx < 0 || stIdx >= showtimes.size()) { System.out.println("Invalid selection."); return; }
        } catch (NumberFormatException e) {
            System.out.println("Invalid input.");
            return;
        }
        Showtime selectedShowtime = showtimes.get(stIdx);

        List<Seat> availableSeats = selectedShowtime.getAvailableSeats();
        if (availableSeats.isEmpty()) { System.out.println("No available seats for this showtime."); return; }

        System.out.println("\n--- Available Seats ---");
        for (int i = 0; i < availableSeats.size(); i++) {
            System.out.print((i + 1) + ". " + availableSeats.get(i) + "   ");
            if ((i + 1) % 5 == 0) System.out.println();
        }
        System.out.println();
        System.out.print("How many seats do you want to book? ");
        int numSeats;
        try {
            numSeats = Integer.parseInt(scanner.nextLine().trim());
            if (numSeats <= 0 || numSeats > availableSeats.size()) {
                System.out.println("Invalid number of seats.");
                return;
            }
        } catch (NumberFormatException e) {
            System.out.println("Invalid input.");
            return;
        }

        List<Seat> chosenSeats = new ArrayList<>();
        for (int i = 0; i < numSeats; i++) {
            System.out.print("Select seat " + (i + 1) + " (enter number): ");
            try {
                int seatIdx = Integer.parseInt(scanner.nextLine().trim()) - 1;
                if (seatIdx < 0 || seatIdx >= availableSeats.size()) {
                    System.out.println("Invalid seat. Skipping.");
                    continue;
                }
                Seat seat = availableSeats.get(seatIdx);
                if (chosenSeats.contains(seat)) {
                    System.out.println("Seat already selected. Choose a different one.");
                    i--;
                    continue;
                }
                chosenSeats.add(seat);
            } catch (NumberFormatException e) {
                System.out.println("Invalid input. Skipping.");
            }
        }

        if (chosenSeats.isEmpty()) { System.out.println("No seats selected."); return; }

        Booking booking = new Booking(bookingCounter++);
        System.out.println("\n--- Select Ticket Type for Each Seat ---");
        System.out.println("1 = Adult (Full Price)  |  2 = Student (20% off)  |  3 = Senior (25% off)");

        for (Seat seat : chosenSeats) {
            System.out.print("Ticket type for Seat " + seat.getRowNumber() + seat.getSeatNumber() + ": ");
            String typeChoice = scanner.nextLine().trim();
            Ticket ticket;
            switch (typeChoice) {
                case "2": ticket = new StudentTicket(selectedShowtime.getPrice()); break;
                case "3": ticket = new SeniorTicket(selectedShowtime.getPrice()); break;
                default:  ticket = new AdultTicket(selectedShowtime.getPrice()); break;
            }
            booking.addTicket(ticket);
            booking.addSeat(seat);
        }

        try {
            currentCustomer.selectSeats(selectedShowtime, chosenSeats);
        } catch (RuntimeException e) {
            System.out.println("Error reserving seats: " + e.getMessage());
            return;
        }

        System.out.print("\nConfirm booking? (y/n): ");
        String confirm = scanner.nextLine().trim().toLowerCase();
        if (confirm.equals("y")) {
            booking.confirmBooking();
            currentCustomer.addBooking(booking);
        } else {
            System.out.println("Booking cancelled.");
        }
    }
}
