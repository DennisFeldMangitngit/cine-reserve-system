import java.util.*;

public class Main {

    static Scanner scanner = new Scanner(System.in);
    static Cinema cinema;
    static Admin admin;
    static Customer currentCustomer;
    static int bookingCounter = 1;

    public static void main(String[] args) {
        // Initialize Cinema
        cinema = new Cinema("CineReserve Pro", "Downtown");
        admin = new Admin("Admin");

        // Seed some default data
        seedDefaultData();

        System.out.println("=============================================");
        System.out.println("       Welcome to CineReserve Pro           ");
        System.out.println("       Location: " + cinema.getAddress());
        System.out.println("=============================================");

        mainMenu();
    }

    static void seedDefaultData() {
        // Default theater rooms
        TheaterRoom room1 = new TheaterRoom("Room 1", "Standard", 30);
        TheaterRoom room2 = new TheaterRoom("Room 2", "Gold Class", 20);
        admin.manageRooms(cinema, room1);
        admin.manageRooms(cinema, room2);

        // Default movies with showtimes
        Movie movie1 = new Movie("Inception");
        List<Seat> seats1 = generateSeats('A', 5);
        Showtime st1 = new Showtime(new Date(), 250.0, seats1);
        admin.addMovie(cinema, movie1);
        admin.setShowtime(movie1, st1);

        Movie movie2 = new Movie("Interstellar");
        List<Seat> seats2 = generateSeats('B', 5);
        Showtime st2 = new Showtime(new Date(), 300.0, seats2);
        admin.addMovie(cinema, movie2);
        admin.setShowtime(movie2, st2);
    }

    static List<Seat> generateSeats(char row, int count) {
        List<Seat> seats = new ArrayList<>();
        for (int i = 1; i <= count; i++) {
            seats.add(new Seat(row, i));
        }
        return seats;
    }

    static void mainMenu() {
        while (true) {
            System.out.println("\n============== MAIN MENU ==============");
            System.out.println("1. Admin Panel");
            System.out.println("2. Customer Portal");
            System.out.println("3. Exit");
            System.out.print("Choose an option: ");

            String choice = scanner.nextLine().trim();

            switch (choice) {
                case "1": adminPanel(); break;
                case "2": customerPortal(); break;
                case "3":
                    System.out.println("Thank you for using CineReserve Pro. Goodbye!");
                    System.exit(0);
                    break;
                default:
                    System.out.println("Invalid option. Please try again.");
            }
        }
    }

    // ==================== ADMIN PANEL ====================

    static void adminPanel() {
        System.out.print("\nEnter Admin Name: ");
        String adminName = scanner.nextLine().trim();
        admin = new Admin(adminName);

        while (true) {
            System.out.println("\n======== ADMIN PANEL (" + adminName + ") ========");
            System.out.println("1. Add Movie");
            System.out.println("2. Remove Movie");
            System.out.println("3. Add Showtime to Movie");
            System.out.println("4. Add Theater Room");
            System.out.println("5. View All Movies");
            System.out.println("6. View Theater Rooms");
            System.out.println("7. Back to Main Menu");
            System.out.print("Choose an option: ");

            String choice = scanner.nextLine().trim();

            switch (choice) {
                case "1": adminAddMovie(); break;
                case "2": adminRemoveMovie(); break;
                case "3": adminAddShowtime(); break;
                case "4": adminAddTheaterRoom(); break;
                case "5": viewAllMovies(); break;
                case "6": viewTheaterRooms(); break;
                case "7": return;
                default: System.out.println("Invalid option.");
            }
        }
    }
    static void adminAddMovie() {
        System.out.print("Enter Movie Title: ");
        String title = scanner.nextLine().trim();
        if (title.isEmpty()) { System.out.println("Title cannot be empty."); return; }
        Movie movie = new Movie(title);
        admin.addMovie(cinema, movie);
    }

    static void adminRemoveMovie() {
        List<Movie> movies = cinema.getMovies();
        if (movies.isEmpty()) { System.out.println("No movies to remove."); return; }
        viewAllMovies();
        System.out.print("Enter movie number to remove: ");
        try {
            int idx = Integer.parseInt(scanner.nextLine().trim()) - 1;
            if (idx < 0 || idx >= movies.size()) { System.out.println("Invalid selection."); return; }
            admin.removeMovie(cinema, movies.get(idx));
        } catch (NumberFormatException e) {
            System.out.println("Invalid input.");
        }
    }

