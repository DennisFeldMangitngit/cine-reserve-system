import java.util.*;

public class Cinema {
    private String name;
    private String address;
    private List<Movie> movies;
    private List<TheaterRoom> theaterRooms;

    public Cinema(String name, String address) {
        this.name = name;
        this.address = address;
        this.movies = new ArrayList<>();
        this.theaterRooms = new ArrayList<>();
    }

    public void addMovie(Movie movie) {
        movies.add(movie);
        System.out.println("Movie added: " + movie.getTitle());
    }

    public void removeMovie(Movie movie) {
        movies.remove(movie);
        System.out.println("Movie removed: " + movie.getTitle());
    }

    public void addTheaterRoom(TheaterRoom room) {
        theaterRooms.add(room);
        System.out.println("Theater room added: " + room.getRoomName());
    }

    public List<Movie> getMovies() {
        return movies;
    }

    public List<TheaterRoom> getTheaterRooms() {
        return theaterRooms;
    }

    public String getName() { return name; }
    public String getAddress() { return address; }
}
